{
  "name": "open-view",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first visual project explorer \u2014 design prototype and bounded static scanner.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "harness:status": "leerness status .",
    "harness:verify": "leerness verify .",
    "check": "node scripts/check-source.mjs",
    "test:e2e": "python scripts/check-ui.py",
    "example:runtime": "node scripts/runtime-example.mjs",
    "build:example": "vite build --config examples/runtime-app/vite.config.mjs",
    "test:integration": "node --test test/integration/*.test.mjs",
    "test:runtime-e2e": "python scripts/check-runtime.py",
    "connect": "node onboarding/cli.mjs",
    "test:connection-e2e": "python scripts/check-connection.py"
  },
  "dependencies": {
    "typescript": "5.8.3"
  },
  "devDependencies": {
    "leerness": "1.36.305",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "7.3.7"
  },
  "bin": {
    "open-view": "onboarding/cli.mjs"
  },
  "exports": {
    "./vite": "./onboarding/vite.mjs",
    "./browser": "./runtime/browser-disabled.mjs",
    "./node": "./runtime/node-sdk.mjs",
    "./postgres": "./runtime/postgres.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "server.mjs",
    "lib/",
    "runtime/",
    "onboarding/",
    "public/",
    "docs/PROJECT-CONNECTION.ko.md",
    "README.md"
  ]
}
